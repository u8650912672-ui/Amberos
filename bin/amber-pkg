#!/bin/sh
export CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
MIRROR="https://mirror.leaseweb.com/artix-linux"
DB_DIR="/var/lib/amber-pkg"
mkdir -p "$DB_DIR"
case "$1" in
  install) pkg="$2"; echo "Installing $pkg...";
  for repo in galaxy os community; do
    url="$MIRROR/$repo/os/x86_64/$pkg"
    curl -fsSL "$url" -o "/tmp/$pkg" 2>/dev/null && break
    wget -q --no-check-certificate "$url" -O "/tmp/$pkg" 2>/dev/null && break
  done
  if [ ! -f "/tmp/$pkg" ]; then echo "Download failed. Check package name."; exit 1; fi
  tar --zstd -xf "/tmp/$pkg" -C / && rm -f "/tmp/$pkg" && echo "$pkg" >> "$DB_DIR/installed" && echo "$pkg installed." ;;
  remove) pkg="$2"; grep -v "$pkg" "$DB_DIR/installed" > "$DB_DIR/tmp" && mv "$DB_DIR/tmp" "$DB_DIR/installed" && echo "$pkg removed." ;;
  list) cat "$DB_DIR/installed" 2>/dev/null ;;
  *) echo "Usage: amber-pkg install|remove|list [package]" ;;
esac
